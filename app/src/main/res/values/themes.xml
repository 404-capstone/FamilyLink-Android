<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Capstone_404" parent="android:Theme.Material.Light.NoActionBar">
        <!-- StatusBar 배경 색상 -->
        <item name="android:statusBarColor">@color/gray</item>
        <!-- 아이콘 색상(검정) -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Capstone_404.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/main</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Capstone_404</item>
    </style>
</resources>